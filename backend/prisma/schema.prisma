// schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// ─────────────── USERS ───────────────

model User {
  id                     String                @id @default(uuid())
  email                  String                @unique
  passwordHash           String?
  fullName               String?
  avatarUrl              String?
  countryOfResidence     String?               // e.g., "GB"
  defaultRoute           String?               // e.g., "GBP-NGN"
  emailVerified          Boolean               @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpiry    DateTime?
  role                   Role                  @default(USER)
  notificationSettings   NotificationSettings?
  alerts                 Alert[]
  comparisons            Comparison[]
  savedRoutes            SavedRoute[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model NotificationSettings {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts             Boolean  @default(true)
  comparisonNotifications Boolean  @default(false)
  marketingEmails         Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model SavedRoute {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCurrency String   // GBP
  toCurrency   String   // NGN
  fromCountry  String   // GB
  toCountry    String   // NG
  label        String?
  createdAt    DateTime @default(now())

  @@unique([userId, fromCurrency, toCurrency])
}

// ─────────────── PROVIDERS ───────────────

model Provider {
  id                  String         @id @default(uuid())
  slug                String         @unique // wise, lemfi, worldremit, remitly
  name                String
  logoUrl             String?
  description         String?
  about               String?
  tagline             String?
  websiteUrl          String
  affiliateUrl        String?
  trustpilotRating    Float?
  trustpilotCount     Int?
  regulatoryInfo      String?
  countriesSupported  Int            @default(0)
  currenciesSupported Int            @default(0)
  paymentMethods      String[]       // BANK_TRANSFER, DEBIT_CARD, CREDIT_CARD
  payoutMethods       String[]       // BANK_ACCOUNT, MOBILE_WALLET, CASH_PICKUP
  deliveryMethods     String[]
  features            String[]       // MOBILE_APP, RATE_NOTIFICATIONS, etc.
  status              ProviderStatus @default(PENDING)
  isActive            Boolean        @default(true)
  routes              ProviderRoute[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model ProviderRoute {
  id           String   @id @default(uuid())
  providerId   String
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  fromCurrency String   // GBP
  toCurrency   String   // NGN
  fromCountry  String?  // GB
  toCountry    String?  // NG
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([providerId, fromCurrency, toCurrency])
}

// ─────────────── COMPARISONS ───────────────

model Comparison {
  id                 String            @id @default(uuid())
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])
  anonymousSessionId String?           // Guest tracking (72h retention)
  fromCurrency       String            // GBP
  toCurrency         String            // NGN
  fromCountry        String            // GB
  toCountry          String            // NG
  sendAmount         Float
  priority           Priority
  paymentMethod      String?           // BANK_TRANSFER, DEBIT_CARD
  deliveryPreference String?           // ANY, FAST, INSTANT
  quotes             ComparisonQuote[]
  staleAt            DateTime          // createdAt + 1 hour (configurable)
  createdAt          DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([anonymousSessionId, createdAt])
}

model ComparisonQuote {
  id                   String      @id @default(uuid())
  comparisonId         String
  comparison           Comparison  @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  provider             String      // provider slug
  exchangeRate         Float
  fees                 Json        // { fixed, percentage, tax, discount, other }
  totalFees            Float
  grossRecipientAmount Float
  recipientAmount      Float
  deliveryEstimate     String      // human-readable: "Minutes", "Within 2 hours"
  deliveryMinutes      Int?        // normalized integer for FASTEST sort
  paymentMethod        String
  ranking              Int?        // null if status !== SUCCESS
  isBestValue          Boolean     @default(false)
  status               QuoteStatus
  errorType            String?     // TIMEOUT, API_ERROR, RATE_LIMIT, INVALID_AUTH
  quoteTimestamp       DateTime
  expiresAt            DateTime?

  @@index([comparisonId])
}

// ─────────────── ALERTS ───────────────

model Alert {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCurrency          String      // GBP
  toCurrency            String      // NGN
  fromCountry           String?
  toCountry             String?
  sendAmount            Float
  targetRecipientAmount Float       // Outcome-based: alert when this amount is reachable
  priority              Priority    @default(MOST_RECEIVED)
  providerPreference    String?     // null = any provider
  paymentMethod         String?
  status                AlertStatus @default(ACTIVE)
  lastCheckedAt         DateTime?
  lastTriggeredAt       DateTime?
  triggeredValue        Float?      // recipient amount that triggered it
  triggeredProvider     String?     // provider slug that triggered it
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status, fromCurrency, toCurrency])
}

// ─────────────── RATE HISTORY ───────────────

model RateSnapshot {
  id              String   @id @default(uuid())
  provider        String   // provider slug
  fromCurrency    String
  toCurrency      String
  sendAmount      Float    // benchmark amount used (e.g., 1000)
  exchangeRate    Float
  recipientAmount Float    // final recipient amount for sendAmount
  totalFees       Float
  paymentMethod   String
  dataType        DataType @default(LIVE) // LIVE or ESTIMATED
  createdAt       DateTime @default(now())

  @@index([provider, fromCurrency, toCurrency, createdAt])
}

// ─────────────── ADMIN / MONITORING ───────────────

model QuoteFailureLog {
  id          String   @id @default(uuid())
  provider    String
  route       String   // e.g., "GBP-NGN"
  errorType   String   // TIMEOUT, SERVICE_UNAVAILABLE, RATE_LIMIT, INVALID_AUTH
  errorDetail String?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
}

model ReferralLink {
  id          String   @id @default(uuid())
  provider    String   @unique
  url         String
  utmSource   String?
  utmCampaign String?
  isActive    Boolean  @default(true)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─────────────── ENUMS ───────────────

enum Role {
  USER
  ADMIN
}

enum Priority {
  MOST_RECEIVED
  FASTEST
  LOWEST_COST
}

enum ProviderStatus {
  INTEGRATED    // live — appears in comparison results
  PENDING       // awaiting API approval — NOT shown in comparison
  UNAVAILABLE   // directory only — no live quote
}

enum QuoteStatus {
  SUCCESS
  FAILED
  TIMEOUT
  RATE_LIMITED
}

enum AlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
  EXPIRED
}

enum DataType {
  LIVE
  ESTIMATED
}
